# Copia este archivo como .env y cambia los valores. Nunca subas el .env al repositorio.

# Base de datos PostgreSQL del servicio (en producción: Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coworkspace_booking

# Puerto HTTP
PORT=3004

# Bus de eventos (en producción: Upstash Redis)
REDIS_URL=redis://localhost:6379

# Servicios que consulta antes de reservar
SPACE_URL=http://localhost:3001
MEMBERSHIP_URL=http://localhost:3002
